{{titulo}}
<p>Página produto em construção...</p>
<fieldset>
    <legend>
        Cadastrar Produto
    </legend>
    <form method="POST" action="/produtos/cadastrar">
        <p>
            <label name="id">
                ID:
            </label>
            <input type="number" min="1" max="10" name="id">
        </p>
        <p>
            <label name="nome">
                Nome:
            </label>
            <input type="text" placeholder="digite o nome do produto">
        </p>
    </form>
</fieldset>