<fieldset>
    <legend>
        Cadastrar cliente
    </legend>
    <form method="post" action="/cliente/cadastrar">
        <p>
            <label for="id">
                Id:
            </label>
            <input type="number" name="id" value=1 min=1 max=10 required>
        </p>
        <p>
            <label for="nome">
                Nome:
            </label>
            <input type="text" name="nome" placeholder="Nome" required>
        </p>
        <input type="submit">

    </form>
</fieldset>