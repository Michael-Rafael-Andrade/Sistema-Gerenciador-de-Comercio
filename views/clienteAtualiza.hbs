{{titulo}}
<hr>
<fieldset>
    <legend>
        Atualizar cliente
    </legend>
    <form action="/clientes/atualiza" method="POST">
        <label for="id">
            ID
        </label>
        <input type="number" name="id" value="{{cliente.id}}" readonly>
        <label for="descricao">
            Nome
        </label>
        <input type="text" name="nome" value="{{cliente.nome}}" required>
        <button type="submit">Salvar Alterações</button>
    </form>
</fieldset>